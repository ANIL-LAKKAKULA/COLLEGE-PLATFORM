APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://identity_user:identity_pass@identity_db:5432/identity_db
TEST_DATABASE_URL=postgresql+asyncpg://identity_user:identity_pass@identity_db:5432/identity_test_db

JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
